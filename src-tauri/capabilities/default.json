{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What Canopy's own UI may do. Listed by webview, not window: the Overleaf pages are child webviews of the main window and get none of this.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/Londopy/*" }]
    }
  ]
}
