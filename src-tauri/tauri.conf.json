{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canopy",
  "mainBinaryName": "Canopy",
  "version": "0.1.0",
  "identifier": "com.londopy.canopy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Canopy",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Londopy",
    "copyright": "Copyright (c) 2026 Londopy",
    "category": "Productivity",
    "shortDescription": "A desktop harness for Overleaf",
    "longDescription": "Canopy wraps the real Overleaf editor in a native app and adds what the browser can't: local folder sync, local compiles with no timeouts, offline editing, snapshots, a Zotero citation picker and a writing dashboard. Works with overleaf.com and self-hosted Overleaf.",
    "licenseFile": "../LICENSE-MIT",
    "homepage": "https://github.com/Londopy/canopy",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0OUNERjE0Q0NEOEFGN0YKUldSL3I5ak1GTitjZER4YlE5dUlJZnJPaUprcWtWR1drVGNiS3FyRHBmWmtLVGt5RG1iRHIwZHoK",
      "endpoints": [
        "https://github.com/Londopy/canopy/releases/latest/download/latest.json"
      ]
    }
  }
}
